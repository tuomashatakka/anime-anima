{
  "name": "anime-anima",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MVP three.js viewer for VRM models with switchable animations (VRMA + BVH).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vrm": "echo 'Open http://localhost:5173/vrm-test.html with the dev server running for the VRM0/VRM1 visual parity test'",
    "download-assets": "node scripts/download-vrm-assets.mts",
    "classify-animations": "node scripts/classify-animations.mts"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "three": "^0.180.0",
    "threejs-scenes": "^2.1.1"
  },
  "devDependencies": {
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
